<rml>
<head>
  <title>Knomira | Noesis-Free Shell</title>
  <style>
    body { margin: 0; background-color: #151f24; color: #e6dfca; font-family: "Segoe UI"; font-size: 18px; }
    #screen { width: 100%; height: 100%; display: flex; flex-direction: column;
              align-items: center; justify-content: center; }
    .panel { width: 640px; padding: 38px; background-color: #28343a;
             border: 3px solid #b5935b; }
    .eyebrow { color: #d0aa72; font-size: 15px; letter-spacing: 2px; }
    h1 { font-size: 60px; color: #f2e4c4; margin: 6px 0px 12px 0px; }
    h2 { font-size: 29px; color: #f2e4c4; margin: 8px 0px 16px 0px; }
    .subtitle { color: #adbbb7; margin-bottom: 26px; }
    button { display: block; width: 100%; min-height: 52px; margin-bottom: 10px;
             padding: 7px; border: 2px solid #92794f; background-color: #384a4b;
             color: #f4e8cd; font-family: "Segoe UI"; font-size: 19px;
             text-align: center; }
    button:hover { background-color: #526462; border-color: #dcc084; }
    button:focus { background-color: #586750; border-color: #fff0ac; }
    button:focus-visible { background-color: #586750; border-color: #fff0ac; }
    button:active { background-color: #6d785e; }
    #save_browser { display: none; }
    #exit_confirm { display: none; }
    #exit_confirm h2 { color: #f2e4c4; }
    #exit_confirm p { color: #c5c9ba; margin: 10px 0px 22px 0px; }
    #exit_yes { border-color: #a36e55; }
    #settings_panel { display: none; }
    #bindings_list { height: 390px; overflow-y: auto; background-color: #172326;
                     padding: 10px; margin-bottom: 10px; }
    .control-group { color: #e3bb7b; font-size: 19px; margin: 14px 0 7px 0;
                     border-bottom: 1px solid #63726b; padding-bottom: 5px; }
    .control-row { background-color: #27383b; margin-bottom: 9px; padding: 8px; }
    .control-name { margin: 0px 0px 7px 0px; font-size: 16px; color: #e5e1d2; }
    button.bind-button { display: inline-block; width: 47%; margin: 1%; min-height: 36px;
                         padding: 4px; font-size: 13px; text-align: center; }
    #binding_capture { display: none; background-color: #323b33; border: 1px solid #d5b077;
                       padding: 10px; margin-bottom: 12px; }
    #capture_prompt { color: #ffe0ac; font-size: 15px; margin: 0px 0px 7px 0px; }
    button.capture-button { display: inline-block; width: 46%; margin: 1%; min-height: 38px;
                            font-size: 15px; }
    button.control-footer { font-size: 16px; min-height: 42px; }

    #save_list { height: 260px; overflow-y: auto; margin-bottom: 12px; padding: 9px;
                 background-color: #192629; }
    #save_list button { text-align: left; font-size: 16px; min-height: 42px; }
    #status { width: 640px; margin-top: 14px; padding: 15px;
              border: 1px solid #6b775f; background-color: #192629;
              color: #b5c6c4; font-size: 15px; }
    #footer { margin-top: 15px; color: #899b98; font-size: 13px; }
  </style>
</head>
<body>
  <div id="screen">
    <div id="menu_panel" class="panel">
      <p class="eyebrow">THE WORLD IS WAITING</p>
      <h1>KNOMIRA</h1>
      <p class="subtitle">Noesis-free engine bootstrap — Phase 4</p>
      <button id="new_game">New Game (not connected)</button>
      <button id="load_game">Browse Existing Saves</button>
      <button id="settings">Settings / Controls</button>
      <button id="quit">Exit</button>
    </div>
    <div id="save_browser" class="panel">
      <p class="eyebrow">ORIGINAL INGNOMIA SAVES</p>
      <h2>Saved Kingdoms</h2>
      <div id="save_list"></div>
      <button id="save_back">Back to Main Menu</button>
    </div>
    <div id="exit_confirm" class="panel">
      <p class="eyebrow">CONFIRM ACTION</p>
      <h2>Exit Knomira?</h2>
      <p>Are you sure you want to close the game?</p>
      <button id="exit_cancel">Cancel — Return to Menu</button>
      <button id="exit_yes">Yes, Exit Knomira</button>
    </div>
    <div id="settings_panel" class="panel">
      <p class="eyebrow">CUSTOMIZE YOUR INPUT</p>
      <h2>Controls and Keybindings</h2>
      <p class="subtitle">Keyboard and Xbox primary / alternate inputs. Planned actions are saved for gameplay.</p>
      <div id="binding_capture">
        <p id="capture_prompt">Press a new key or controller input.</p>
        <button class="capture-button" id="capture_clear">Clear binding</button>
        <button class="capture-button" id="capture_cancel">Cancel</button>
      </div>
      <div id="bindings_list"></div>
      <button class="control-footer" id="controls_reset">Restore Default Controls</button>
      <button class="control-footer" id="controls_back">Return to Main Menu</button>
    </div>
    <div id="status">Use keyboard or Xbox controller to navigate.</div>
    <p id="footer">Read-only testing. Your game files are never modified.</p>
  </div>
</body>
</rml>
