<rml>
<head>
  <title>Knomira | Engine Overlay Diagnostics</title>
  <style>
    body {
      width: 100%;
      height: 100%;
      margin: 0;
      padding: 0;
      background-color: transparent;
      font-family: "Segoe UI";
      color: #f2e4c4;
      pointer-events: none;
    }
    #indicator {
      position: absolute;
      top: 14px;
      right: 14px;
      width: 295px;
      padding: 12px 16px;
      background-color: #1a242be8;
      border: 2px solid #b5935b;
      pointer-events: none;
    }
    #heading { color: #f2dfb1; font-size: 19px; margin-bottom: 6px; }
    #details { color: #b5c6c4; font-size: 14px; }
  </style>
</head>
<body>
  <div id="indicator">
    <div id="heading">KNOMIRA / RmlUi</div>
    <div id="details">In-engine overlay active (test mode)</div>
    <div id="details-2" style="font-size: 13px; color: #b5c6c4;">Noesis input and colony simulation unchanged.</div>
  </div>
</body>
</rml>
